# Public canonical HTTPS origin. CRM uses it for the bank's return URL.
SITE_URL=http://localhost:3000

# Workspace token with products:read, orders:read/write, payments:read/write
# and shipments:read. Issued in the client's Obriym CRM account.
OBRIYM_CRM_API_KEY=
# OBRIYM_CRM_API_URL=https://obriym-crm.com/api/v1

# Optional stable session secret, at least 32 characters.
# Without it, the CRM API key protects the checkout session.
# CHECKOUT_SESSION_PASSWORD=

# First-order contact popup. Enable only after real offer terms are approved.
# Requires leads:write on the CRM token; contacts become website leads.
WELCOME_OFFER_ENABLED=false
# WELCOME_OFFER_TITLE=
# WELCOME_OFFER_DESCRIPTION=
