# Public canonical HTTPS origin. CRM uses it for the bank's return URL.
SITE_URL=http://localhost:3000

# Workspace token bound to the site's sales source, issued in the client's
# Obriym CRM account. Scopes: products:read, orders:read, orders:write,
# payments:read, payments:write, shipments:read, reviews:read, reviews:write,
# leads:write (B2B form); contacts:read and contacts:write for the popup.
OBRIYM_CRM_API_KEY=
# OBRIYM_CRM_API_URL=https://obriym-crm.com/api/v1

# Home social proof (docs/social-proof.md): the owner's customer count across
# every channel. The CRM only counts delivered orders the site created, so the
# home page shows the larger of the two, rounded down. Empty = CRM count only.
# SOCIAL_PROOF_CUSTOMERS_MANUAL=

# Optional stable session secret, at least 32 characters.
# Without it, the CRM API key protects the checkout session.
# CHECKOUT_SESSION_PASSWORD=

# First-order popup: the shop's own texts with the CRM campaign's figures;
# one-step capture mails the code. Needs a CRM with capture figures (0264).
# Token scopes: contacts:read, contacts:write, orders:read, orders:write
# (plus products/payments/shipments scopes above).
# Enable after the campaign, CRM migrations and mail worker are ready.
WELCOME_OFFER_ENABLED=false
WELCOME_OFFER_CAMPAIGN_ID=ididididid

# Newsletter checkbox at checkout; sends customer.marketingConsent to the CRM.
# Keep off until the CRM with marketingConsent support is deployed (its customer
# schema is strict, so the field would reject the whole order).
CRM_SEND_MARKETING_CONSENT=false
