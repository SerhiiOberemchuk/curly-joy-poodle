# Public canonical URL without a trailing slash. Required for LiqPay callbacks.
SITE_URL=http://localhost:3000

# mock: local simulation with a stand-in payment page, no LiqPay keys needed
# sandbox: LiqPay sandbox checkout, keys required
# live: production payments, keys required
LIQPAY_MODE=mock
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Send the basket to LiqPay as fiscalisation data (rro_info). Only switch this
# on when ПРРО is enabled in the LiqPay account — see docs/liqpay.md.
# LIQPAY_RRO=true

# Where the stopgap order log writes its JSON files. Defaults to .tmp/orders.
# On a read-only filesystem the store degrades to memory only — see docs/liqpay.md.
# ORDER_STORE_DIR=

# mock: simulate the hand-off to SalesDrive and log the payload it would send
# off:  skip the CRM entirely (the default in production)
CRM_MODE=mock
# CRM_FORM_ID=
